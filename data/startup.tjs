// ----------------------------------------------------------------------
// 共通ダイアログサンプル — VK_D / VK_E / VK_O で同じ JSON を使ってフォーカス
// 挙動を比較しやすくする
// ----------------------------------------------------------------------
function commonDialogJson()
{
    return @'
    {
        /* JSONC 対応: 行コメントとブロックコメント、 末尾カンマが
           使えるようになった (picojson の前段で strip する仕組み)。 */
        "size": [560, 600],
        "background": [40, 40, 50, 240],
        "locale": "ja-JP",

        /* 入力設定 (Elements 新 API):
             arrow_focus_nav: 矢印キー / アナログスティック (focus モード) で
                              2D フォーカス移動を有効化
             pad_bindings:    pad ボタン → key の override (デフォルト
                              A=Enter / B=Esc / X=Shift+Tab / Y=Tab)
             shortcuts:       任意 key/pad → 要素 id のショートカット。
                              LB / RB を直接 OK / Cancel ボタンに割当てる。 */
        "input": {
            "arrow_focus_nav": true,
            "dpad_mode":        "both",
            "left_stick_mode":  "focus",
            "right_stick_mode": "value",
            "shortcuts": [
                { "pad": "lb", "target": "cancel" },
                { "pad": "rb", "target": "ok", "force": true }
            ]
        },

        "content": {
            "type": "margin", "padding": 16,
            "child": {
                "type": "vtile",
                "children": [
                    // つっかえ棒: vtile の幅を 528 (= 560 - margin 16*2) で
                    // 強制し、 ダイアログ全体を 560 幅にする。
                    { "type": "hspacer", "width": 528 },

                    { "type": "align_center",
                      "child": { "type": "label",
                                 "text": "Elements ウィジェットデモ",
                                 "size": 1.3 } },

                    { "type": "group", "title": "ボタン",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "htile",
                                            "children": [
                                                /* close_on_click 省略 = false
                                                   → click しても modal は閉じず、
                                                     onAction だけ発火する */
                                                { "type": "hsize", "width": 120,
                                                  "child": { "type": "button",
                                                             "id": "hello", "text": "こんにちは" } },
                                                { "type": "hsize", "width": 120,
                                                  "child": { "type": "toggle_button",
                                                             "id": "togA", "text": "切り替え" } }
                                            ] } } },

                    { "type": "group", "title": "選択",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "vtile",
                                            "children": [
                                                { "type": "align_left",
                                                  "child": { "type": "checkbox",
                                                             "id": "cb1",
                                                             "text": "機能 A を有効化",
                                                             "value": true } },
                                                { "type": "align_left",
                                                  "child": { "type": "checkbox",
                                                             "id": "cb2",
                                                             "text": "機能 B を有効化 (Enable B)" } },
                                                { "type": "align_left",
                                                  "child": { "type": "htile",
                                                             "children": [
                                                                 { "type": "label",
                                                                   "text": "電源 Power " },
                                                                 { "type": "slide_switch",
                                                                   "id": "sw1",
                                                                   "value": true }
                                                             ] } }
                                            ] } } },

                    { "type": "group", "title": "テキスト入力",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "vsize", "height": 30,
                                            "child": { "type": "input_box",
                                                       "id": "name",
                                                       "placeholder": "お名前を入力..." } } } },

                    { "type": "group", "title": "Locale 比較 (同じ Han 字コード)",
                      "child": { "type": "margin", "padding": [10, 45, 10, 10],
                                 "child": { "type": "vtile",
                                            "children": [
                                                { "type": "align_left",
                                                  "child": { "type": "label",
                                                             "text": "ja-JP : 直 骨 次 海 雪 公",
                                                             "locale": "ja-JP" } },
                                                { "type": "align_left",
                                                  "child": { "type": "label",
                                                             "text": "zh-TW : 直 骨 次 海 雪 公",
                                                             "locale": "zh-TW" } }
                                            ] } } },

                    { "type": "align_right",
                      "child": { "type": "htile",
                                 "children": [
                                     { "type": "hsize", "width": 110,
                                       /* initial_focus: 起動時にここへフォーカス。
                                          close_on_click: true で modal を閉じる
                                          (デフォルト false の button は閉じない、
                                           onAction だけ発火する)。 */
                                       "child": { "type": "button", "initial_focus": true,
                                                  "close_on_click": true,
                                                  "id": "ok", "text": "OK" } },
                                     { "type": "hsize", "width": 110,
                                       "child": { "type": "button",
                                                  "close_on_click": true,
                                                  "id": "cancel", "text": "キャンセル" } }
                                 ] } }
                ]
            }
        }
    }
    ';
}

// ----------------------------------------------------------------------
// VK_D: 非同期オーバーレイダイアログ (Dialog.showJson, onAction で受ける)
// ----------------------------------------------------------------------
class TestDialog extends Dialog
{
    function TestDialog() { super.Dialog(); }
    function onAction(id, payload) {
        dm(@"Dialog action: ${id} payload=${payload}");
        switch (id) {
        case "ok":
            System.inform("OK pressed");
            close();
            break;
        case "cancel":
            close();
            break;
        }
    }
}

var dialogTestInstance = void;

function dialogTest()
{
    if (dialogTestInstance !== void) invalidate dialogTestInstance;
    dialogTestInstance = new TestDialog();
    dialogTestInstance.showJson(commonDialogJson());
}

// ----------------------------------------------------------------------
// showModal* 用ハンドラ。 close_on_click=false な button (hello / togA 等) の
// 押下を観測する用。 ok / cancel は元々 close_on_click=true なので modal が
// 閉じてから result.action として帰ってくる (それも一応 onAction にも来る)。
// ----------------------------------------------------------------------
class ModalActionDialog extends Dialog
{
    function ModalActionDialog() { super.Dialog(); }
    function onAction(id, payload) {
        dm(@"  modal onAction: id=${id} payload=${payload}");
    }
}

// ----------------------------------------------------------------------
// VK_E: 独立 SDL_Window モーダル (showModalJson with title, ブロッキング)
// ----------------------------------------------------------------------
function modalTest()
{
    var dlg = new ModalActionDialog();
    var result = dlg.showModalJson(commonDialogJson(),
        "モーダルテスト (独立 window)", 560, 700);

    if (result === void) {
        System.inform("modal failed");
        return;
    }
    dm(@"Modal (window) result: action='${result.action}'");
    System.inform(@"window modal: action=${result.action}");
}

// ----------------------------------------------------------------------
// VK_O: オーバーレイモーダル (showModalJson 1 引数、 ゲーム window 上に被せる)
// ----------------------------------------------------------------------
function modalOverlayTest()
{
    var dlg = new ModalActionDialog();
    var result = dlg.showModalJson(commonDialogJson());

    if (result === void) {
        System.inform("overlay modal failed");
        return;
    }
    dm(@"Modal (overlay) result: action='${result.action}'");
    System.inform(@"overlay modal: action=${result.action}");
}


class MyWindow extends Window
{
    var primaryLayer;
    var base1;
    var base2;

    var layer1, layer2, layer3, layer4;

    var timer;
    var start_tick;
    var sound;
    var phaseVocoder;
    var soundSpeed = 1.0;
    var soundPlayRequested = false;
    var soundOpened = false;
    var soundStorage = "bgm01_dummy.ogg";
    var seStorage = "se_dummy.ogg";

	var bg;
	var ev;
    var text;
    var videolay;
    var video;

    var saveDataLocation;

    function createBaseLayer() {
        var lay = new BaseLayer(this, primaryLayer);
        lay.setSize(WIDTH, HEIGHT);
        lay.fillRect(0,0,lay.width,lay.height,0x00000000);
        add(lay);
        return lay;
    }

    function MyWindow() {
        super.Window(...);

        if (false && typeof global.Window.BasicDrawDevice == "undefined") {
            drawDevice = new MyDrawDevice();
            this.waitVSync = true;
        }
        this.waitVSync = true;

        setInnerSize(WIDTH, HEIGHT);
        primaryLayer = new Layer(this, null);
        primaryLayer.setSize(WIDTH, HEIGHT);
        // デバッグ用: 全面を紺で塗ったあと 64px 単位でグリッド線、中心に十字
        // (赤=水平方向中心軸、緑=垂直方向中心軸)。ダイアログ位置のセンタ
        // リング確認用。
        primaryLayer.fillRect(0, 0, WIDTH, HEIGHT, 0xff202040);
        var gridColor = 0xff404060;
        for (var x = 0; x <= WIDTH; x += 64) {
            primaryLayer.fillRect(x, 0, 1, HEIGHT, gridColor);
        }
        for (var y = 0; y <= HEIGHT; y += 64) {
            primaryLayer.fillRect(0, y, WIDTH, 1, gridColor);
        }
        primaryLayer.fillRect((WIDTH \ 2) - 1, 0, 3, HEIGHT, 0xffff4040);
        primaryLayer.fillRect(0, (HEIGHT \ 2) - 1, WIDTH, 3, 0xff40ff40);
        add(primaryLayer);

        if (drawDevice instanceof "OGLDrawDevice") {
            primaryLayer.type = ltAlpha; 
        }

        base1 = createBaseLayer();
        base1.visible = true;
        base2 = createBaseLayer();

        bg = new Layer(this, base2);
        bg.loadImages("bg.jpg");
		bg.setSizeToImageSize();
        bg.visible = true;
        add(bg);

        ev = new Layer(this, base2);
        ev.loadImages("fg.png");
		ev.setSizeToImageSize();
        ev.visible = true;
        add(ev);

        var layer1_color = 0xffff0000;
        var layer2_color = 0x800000ff;
        var layer3_color = 0x8000ff00;
        var layer4_color = 0x80ff0000;
    
        layer2 = new Layer(this, base1);
        layer2.setSize(400,400);
        layer2.setPos(100,100);
        layer2.fillRect(0,0,400,400,layer2_color);
        layer2.type = ltAlpha;
        layer2.visible = true;
        add(layer2);
        
        layer3 = new Layer(this, base1);
        layer3.setSize(400,400);
        layer3.setPos(400,200);
        layer3.fillRect(0,0,400,400,layer3_color);
        layer3.type = ltAlpha;
        layer3.visible = true;
        add(layer3);
        
        layer4 = new Layer(this, base1);
        layer4.setSize(400,400);
        layer4.setPos(700,300);
        layer4.fillRect(0,0,400,400,layer4_color);
        layer4.type = ltAlpha;
        layer4.visible = true;
        add(layer4);

        layer1 = new Layer(this, base1);
        layer1.setSize(600,600);
        layer1.fillRect(0,0,600,600,layer1_color);
        layer1.setPos(300,300);
        layer1.type = ltAlpha;
        layer1.visible = true;
        add(layer1);

        sound = new WaveSoundBuffer(this);
        sound.onStatusChanged = function() {
            dm(@"bgm status change:${this.status}");
        } incontextof sound;
        phaseVocoder = new WaveSoundBuffer.PhaseVocoder();
        phaseVocoder.time = soundSpeed;
        phaseVocoder.pitch = 1.0;
        sound.filters.clear();
        sound.filters.add(phaseVocoder);
        dm(@"PhaseVocoder speed:${soundSpeed}");

        timer = new Timer(this, "onTimer");
        timer.interval = 1000/60;
        dm(@"Timer created: ${timer.interval}ms interval");

        saveDataLocation = System.dataPath;
        dm(@"セーブデータ場所:${saveDataLocation}");

        fontText();

        System.addContinuousHandler(onContinuous);
    }

    var frameCount;
    var prevTick;
    var fps;    

    function calcFPS() {
        frameCount++;
        var tick = System.getTickCount();
        if (prevTick === void) prevTick = tick;
        var time = tick - prevTick;
        if (time >= 1000) {
            fps = frameCount * 1000 / time;
            frameCount = 0;
            prevTick = tick;
            this.caption = @"fps:${fps}";
        }
    }

    var contCount = 0;

    function onContinuous() {
        //dm(@"onContinuous:${contCount++}");
        calcFPS();
    }

    function drawDeviceChange() {
        if (typeof global.Window.BasicDrawDevice == "undefined") {
            return;
        }
        if (drawDevice instanceof "BasicDrawDevice") {
            dm("OGLDrawDeviceに変更");
            drawDevice = new MyDrawDevice();
            primaryLayer.type = ltAlpha; 
            this.waitVSync = true;
        } else {
            dm("BasicDrawDeviceに戻す");
            drawDevice = new global.Window.BasicDrawDevice();
            primaryLayer.type = ltOpaque; 
        }
    }

    function onStatusChanged(status) {
        dm(@"bgm status change:${status}");
    }

     function saveTest() {
        var saveFile = saveDataLocation + "savedata.txt";
        var data = %["test","abc", "array",[1,2,3,4,5]];
        try {
            dm(@"セーブ処理実行:${saveFile}");
            (Dictionary.saveStruct incontextof data)(saveFile);
            Storages.commitSavedata();
        } catch(e) {
            dm(@"セーブ処理失敗:${e.message}");
            Storages.rollbackSavedata();
        }
    }

    function loadTest() {
        var saveFile = saveDataLocation + "savedata.txt";
        var data;
        try {
            dm(@"ロード処理実行:${saveFile}");
            data = Scripts.evalStorage(saveFile);
            dm(@"dataload:${Scripts.toStructString(data)}");
        } catch(e) {
            dm(@"ロード処理失敗:${e.message}");
        }
    }

    function onTimer() {
        var tick = System.getTickCount() - start_tick;
        var alpha = 255 * (Math.sin(2*Math.PI * tick/4000.0) + 1) / 2;
        dm(@"tick:${tick} alpha:${alpha}");
        layer1.opacity = alpha;
    }

    function soundTest() {
        soundPlayRequested = !soundPlayRequested;
        if (soundPlayRequested) {
            if (!soundOpened) {
                sound.open(soundStorage);
                soundOpened = true;
            }
            if (sound.status != "play") {
                sound.play();
            }
        } else {
            if (sound.status == "play") {
                sound.stop();
            }
        }
    }

    function updateSoundSpeed(delta) {
        var wasPlaying = (sound.status == "play");

        soundSpeed += delta;
        if (soundSpeed < 0.25) soundSpeed = 0.25;
        if (soundSpeed > 2.0) soundSpeed = 2.0;

        if (phaseVocoder !== void) {
            phaseVocoder.time = soundSpeed;
        }

        if (wasPlaying) {
            sound.stop();
            sound.open(soundStorage);
            soundOpened = true;
            sound.play();
        }

        dm(@"PhaseVocoder speed:${soundSpeed}");
    }

    function seTest() {
        sound.stop();
        sound.open(seStorage);
        sound.play();
    }

    function timerTest() {
        if (timer.enabled) {
            timer.enabled = false;
            layer1.opacity = 255;
        } else {
            start_tick = System.getTickCount();
            dm(@"start_tick:${start_tick}");
            timer.enabled = true;
        }
    }

    function videoTest0() {
        if (video) {
            video.stop();
            video.close();
            video = void;
        } else {
            video = new VideoOverlay(this);
            video.onStatusChanged = function(status) {
                dm(@"video status change:${status}");
            } incontextof video;
            video.mode = vomMixer;
            video.open("title.webm");
            video.play();
        }
    }

    function videoTest1() {
        if (video) {
            video.stop();
            video.close();
            video = void;
        } else {
            video = new VideoOverlay(this);
            video.mode = vomMixer;
            video.open("title.mp4");
            video.play();
        }
    }


    function videoTest() {
        if (videolay) {
            video.stop();
            video.close();
            video = false;
            invalidate videolay;
            videolay = void;
            return;
        }

        videolay = new Layer(this, primaryLayer);
        videolay.setSize(1920,1080);
        videolay.fillRect(0,0,1920,1080,0xffffffff);
        videolay.setSizeToImageSize();
        //videolay.setPos(500,200);
        videolay.type = ltOpaque;
        videolay.visible = true;
        add(videolay);

        video = new VideoOverlay(this);
        video.onStatusChanged = function(status) {
            dm(@"video status change:${status}");
        } incontextof video;
        video.mode = vomLayer;
        video.layer1 = videolay;
        video.open("title.webm");
        video.play();
    }

    function fontText() {
        text = new Layer(this, primaryLayer);
        text.setSize(1000,100);
        text.fillRect(0,0,1000,100,0xff000000);
        text.setPos(100,600);
        text.visible = true;
        add(text);

        dm(@"フォントフェイス:${text.font.face}");
        text.font.height = 32;
        var width = text.font.getTextWidth("てすと");
        dm(@"フォントサイズの取得:${width}");
        text.drawText(10,10,"これは表示テストです", 0xffffff, 255);
    }

    function onTransitionCompleted() {
        base1 <-> base2;
    }

    function transTest(param) {
        if (base1.inTransition) {
            base1.stopTransition();
        }
        base1.beginTransition(base2, param);
    }

    function onKeyDown(key, shift) {
        dm(@"onKeyDown:${key}:${getKeyCodeName(key)}");
        switch (key) {
        case VK_X:
            drawDeviceChange();
            break;
		case VK_M:
            soundTest();
			break;
        case VK_N:
            seTest();
            break;
        case VK_UP:
            updateSoundSpeed(0.1);
            break;
        case VK_DOWN:
            updateSoundSpeed(-0.1);
            break;
		case VK_V:
        case VK_PAD2:
            videoTest();
			break;
        case VK_W:
        case VK_PAD3:
            videoTest0();
			break;
		case VK_S:
            saveTest();
			break;
		case VK_L:
            loadTest();
			break;
		case VK_T:
            transTest(%[method:"crossfade", time:2000]);
			break;
		case VK_U:
            transTest(%[method:"universal", rule:"map07.png", time:2000]);
			break;
        case VK_D:
        case VK_PAD1:
            dialogTest();
            break;
        case VK_E:
            modalTest();
            break;
        case VK_O:
            modalOverlayTest();
            break;
		case VK_I:
            timerTest();
            break;
        }
    }

    function onKeyUp(key, shift) {
        dm(@"onKeyUp:${key}");
    }

};

var win = new MyWindow();
win.visible = true;

// ============================================================================
//  androidconfig - Android「機能設定」画面 ↔ 吉里吉里本体コンフィグ連携サンプル
// ----------------------------------------------------------------------------
//  Android 側 (SettingsActivity) が、これらのグローバル関数が「定義されていれば」
//  呼び出して設定画面を構築・同期する。ここではテスト用に値をインメモリの
//  グローバル辞書に保持するだけの実装。実案件では「// → 配線例」の箇所を
//  案件のエンジン/システム変数 (KAG なら kag.* / Config.tjs、自前システムなら
//  その設定オブジェクト) に差し替える。
//
//  契約とキー一覧: app/src/main/cpp/androidconfig/manual.tjs
//  参考実装(雛形):  app/src/main/cpp/androidconfig/sample_config.tjs
//  案件側の手順:    app/src/main/cpp/androidconfig/SETUP.md
// ============================================================================

// ---- 設定値の保管庫 (案件では実際の設定変数の getter/setter に置き換える) ----
if (typeof global.KrkrzAndroidConfigStore == "undefined") {
    global.KrkrzAndroidConfigStore = %[
        // システム
        "screenEffect"        => 1,
        "systemEffect"        => 1,
        "windowOpacity"       => 100,
        // メッセージ
        "messageSpeed"        => 50,
        "autoModeSpeed"       => 50,
        "autoReleaseOnChoice" => 1,
        "autoWaitVoice"       => 1,
        "skipMode"            => 0,    // 0=既読のみ / 1=すべて
        "skipReleaseOnChoice" => 1,
        "skipReadText"        => 0,
        // 音量に付随する ON/OFF
        "lowerBgmOnVoice"     => 1,
        "lowerSeOnVoice"      => 0,
        // 言語
        "mainTextLang"        => "ja",
        "subTextLang"         => "en"
    ];
}

// ---- 音量の保管庫 (0-100)。案件では実際の音量に置き換える ----
if (typeof global.KrkrzAndroidVolumeStore == "undefined") {
    global.KrkrzAndroidVolumeStore = %[
        "master"      => 100,
        "bgm"         => 80,
        "se"          => 80,
        "systemSe"    => 80,
        "voice"       => 90,
        "systemVoice" => 90
        // "charVoice:主人公" => 90, ... のように動的に増やせる
    ];
}

// キャラ別ボイス名 (改行区切り)。空文字なら「キャラ別ボイス」セクションは出ない。
if (typeof global.KrkrzAndroidCharVoiceNames == "undefined") {
    global.KrkrzAndroidCharVoiceNames = "";
    // テストでキャラ別ボイススライダを出すなら例えば:
    // global.KrkrzAndroidCharVoiceNames = "主人公\nヒロインA\nヒロインB";
}

// ----------------------------------------------------------------------------
//  KrkrzAndroidGetConfig() -> Dictionary   (設定画面オープン時に呼ばれる)
// ----------------------------------------------------------------------------
function KrkrzAndroidGetConfig()
{
    Debug.message("[androidconfig] GetConfig called");

    var d = %[];
    // スナップショットを複製して返す。辞書の assign は直呼びできず
    // (Dictionary.assign incontextof d)(...) の形で呼ぶ必要がある。
    (Dictionary.assign incontextof d)(global.KrkrzAndroidConfigStore);

    // 言語の選択肢一覧 (値<TAB>表示名、改行区切り)。
    d["mainTextLangList"] = "ja\t日本語\nen\tEnglish\nzh-CN\t简体中文\nzh-TW\t繁體中文";
    d["subTextLangList"]  = "ja\t日本語\nen\tEnglish\nzh-CN\t简体中文\nzh-TW\t繁體中文";

    // キャラ別ボイス名一覧。
    d["charVoiceNames"] = global.KrkrzAndroidCharVoiceNames;

    return d;
}

// ----------------------------------------------------------------------------
//  KrkrzAndroidSetConfig(dict) -> void   (画面を閉じるとき編集値=音量以外を一括通知)
// ----------------------------------------------------------------------------
function KrkrzAndroidSetConfig(dict)
{
    if (dict === void) return;
    var store = global.KrkrzAndroidConfigStore;
    var keys = [
        "screenEffect","systemEffect","windowOpacity",
        "messageSpeed","autoModeSpeed","autoReleaseOnChoice","autoWaitVoice",
        "skipMode","skipReleaseOnChoice","skipReadText",
        "lowerBgmOnVoice","lowerSeOnVoice",
        "mainTextLang","subTextLang"
    ];
    for (var i = 0; i < keys.count; i++) {
        var k = keys[i];
        if (dict[k] !== void) {
            store[k] = dict[k];
            Debug.message(@"[androidconfig] SetConfig ${k} = ${dict[k]}");
        }
    }

    // → 配線例: ここで案件のエンジン変数へ反映 + 永続化する。
    //   kag.skipMode         = store["skipMode"];
    //   kag.autoModeInterval = 1000 - store["autoModeSpeed"] * 9;   // 速度→ms 変換例
    //   Config.windowOpacity = store["windowOpacity"];
}

// ----------------------------------------------------------------------------
//  KrkrzAndroidGetVolume(key) -> int(0-100)   未知キーは void
// ----------------------------------------------------------------------------
function KrkrzAndroidGetVolume(key)
{
    var store = global.KrkrzAndroidVolumeStore;
    if (store[key] !== void) return +store[key];
    if (key.indexOf("charVoice:") == 0) return 90;   // charVoice:* は未登録ならデフォルト 90
    return void;                                      // 未知キー → その行は表示されない
}

// ----------------------------------------------------------------------------
//  KrkrzAndroidSetVolume(key, value) -> void   value:0-100   (スライダー操作でライブ反映)
// ----------------------------------------------------------------------------
function KrkrzAndroidSetVolume(key, value)
{
    var v = +value;
    if (v < 0) v = 0; else if (v > 100) v = 100;
    global.KrkrzAndroidVolumeStore[key] = v;
    Debug.message(@"[androidconfig] SetVolume ${key} = ${v}");

    // → 配線例: 実際の音量へ即時反映する。
    //   吉里吉里Z の WaveSoundBuffer.GlobalVolume は 0-100000。0-100 をスケールする。
    switch (key) {
    case "master":
        // WaveSoundBuffer.GlobalVolume = v * 1000;
        break;
    case "bgm":
        // bgmBuffer.volume2 = v * 1000;
        break;
    case "se":
    case "systemSe":
        // se チャンネルの volume2 を更新
        break;
    case "voice":
    case "systemVoice":
        // ボイスチャンネルの volume2 を更新
        break;
    default:
        if (key.indexOf("charVoice:") == 0) {
            // var name = key.substring(10);  // "charVoice:" を除いたキャラ名
            // 該当キャラのボイスチャンネル音量へ反映
        }
        break;
    }
}

dm("startup done");
