var WIDTH = 1920;
var HEIGHT = 1080;

var blendTest = true;

class BaseLayer extends Layer
{
    var _inTransition;

    function BaseLayer(win, parent) {
        super.Layer(win, parent);
    }

    property inTransition {
        getter() { return _inTransition; }
    }

    function beginTransition(target, param) {
        _inTransition = true;
        super.beginTransition(param.method, true, target, param);
    }

    function onTransitionCompleted() {
        _inTransition = false;
        window.onTransitionCompleted();
    }
}
