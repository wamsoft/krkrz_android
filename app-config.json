{
    "applicationId": "jp.wamsoft.krkrz.sample",
    "versionCode": 1,
    "versionName": "1.0",
    "compileSdk": 36,
    "targetSdk": 36,
    "minSdk": 29,
    "ndkVersion": "28.2.13676358",
    "cmake": {
        "pluginFolders": [
            "app/src/main/cpp",
            "${KRKRZ_BASE}/wamsoft_work",
            "${KRKRZ_BASE}/krkrtemplate/plugins"
        ],
        "plugins": [
            "csvParser",
            "playgames",
            "getSample",
            "json",
            "KAGParserEx",
            "layerExBTOA",
            "layerExImage",
            "layerExRaster",
            "saveStruct",
            "scriptsEx",
            "shrinkCopy",
            "getLangName",
            "textrender",
            "tjsDataPack",
            "tlgSliceLoader",
            "psbfile"
        ],
        "staticPlugins": [
            "playgames"
        ]
    },
    "assetPack": {
        "projectFolder": "${KRKRZ_BASE}/krkrz_dev/src/core",
        "sources": [
            {
                "type": "mirror",
                "from": "data",
                "include": ["**/*"],
                "exclude": ["**/*.bak", "**/*.psd"]
            },
            {
                "type": "flatten",
                "from": "archive",
                "include": ["*.xp3"]
            }
        ]
    }
