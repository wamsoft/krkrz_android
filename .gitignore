# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA / Android Studio (all IDE-local; nothing here is shared)
.idea/
*.iml
*.ipr
*.iws

# Keystore (security)
*.jks
*.keystore
!debug.keystore

# Heap dumps
*.hprof

# NDK
.externalNativeBuild
.cxx/

# Native C++
obj/
cmake_build/

# Downloaded on demand by scripts/pad-local-install.sh
/tools/bundletool-all-*.jar

# Python (REPL client のキャッシュ)
__pycache__/
*.pyc

# Misc
.DS_Store
Thumbs.db

.vscode/
app/libs/*.aar

# Claude Code local settings
.claude/

# サンプル案件データ: startup.tjs (TJS 配線サンプル) のみ追跡し、
# 動画など大きな素材 (title.webm 等) は追跡しない。
data/*
!data/startup.tjs