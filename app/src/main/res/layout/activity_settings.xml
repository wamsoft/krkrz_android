<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- 大画面 (タブレット横向き等) では各行が画面いっぱいに伸びて間延びするため、
         SettingsActivity 側で幅を上限 (settings_content_max_width) に制限し中央寄せする。
         layout_gravity が効くよう ScrollView (= FrameLayout) の直下に置く。 -->
    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_virtualpad"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:paddingBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_vpad_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_vpad_enabled" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_vpad_enabled_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/text_vpad_opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_vpad_opacity"
            android:textAppearance="?attr/textAppearanceBody2" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_vpad_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="10"
            android:valueTo="100"
            android:stepSize="5"
            android:value="55" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_vpad_opacity_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- 吉里吉里本体 (TJS) 側のコンフィグ。KrkrzConfig 経由で取得し
             SettingsActivity が実行時にこのコンテナへ動的に行を追加する。 -->
        <LinearLayout
            android:id="@+id/config_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp" />

    </LinearLayout>

</ScrollView>
